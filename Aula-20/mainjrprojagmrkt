    """Coleta os dados dos campos e salva no SQLite3."""
    titulo = locadora.txt_nome.get().strip()
    genero = locadora.txt_genero.get().strip()
    classind = locadora.txt_classind.get().strip()
    direcao = locadora.txt_direcao.get().strip()
    estudio = locadora.txt_estudio.get().strip()

    if not titulo or not genero or not classind or not direcao or not estudio:
        messagebox.showwarning("Aviso", "Por favor, preencha todos os campos!")
        return

    conn = conectar()
    cursor = conn.cursor()
    cursor.execute('INSERT INTO filmes (titulo, genero, classind, direcao, estudio) VALUES (?, ?, ?, ?, ?)', (titulo, genero, classind, direcao, estudio))
    conn.commit()
    conn.close()

