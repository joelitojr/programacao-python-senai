import sqlite3
import customtkinter as ctk
from tkinter import messagebox

# --- Funções do Banco de Dados e Lógica ---
def conectar():
    return sqlite3.connect("locadora.db")

def init_db():
    """Cria o banco de dados e a tabela se não existirem."""
    conn = conectar()
    cursor = conn.cursor()
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS filmes (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            titulo TEXT NOT NULL,
            genero TEXT NOT NULL,
            classind INTERGER NOT NULL,
            direcao TEXT,
            estudio TEXT
        )
    ''')
    conn.commit()
    conn.close()

# Exibir registros
def atualizar_lista():
    """Busca os filmes no banco e carrega/exibe no campo de texto."""
    # Libera a caixa de texto temporariamente para escrita
    locadora.frame_lista.configure(state="normal")
    locadora.frame_lista.delete("0.0", "end")

    # Limpa os campos de texto
    locadora.txt_nome.delete(0, "end")
    locadora.txt_genero.delete(0, "end")
    locadora.txt_classind.delete(0, "end")
    locadora.txt_direcao.delete(0, "end")
    locadora.txt_estudio.delete(0, "end")

    conn = conectar()
    cursor = conn.cursor()
    cursor.execute("SELECT id, titulo, genero, classind, direcao, estudio FROM filmes ORDER BY id DESC")
    filmes = cursor.fetchall()
    conn.close()

    if not filmes:
        locadora.frame_lista.insert("0.0", "Nenhum filme cadastrado no acervo.")
    else:
        for filme in filmes:
            linha = f"ID: {filme[0]} | {filme[1]} — {filme[2]} — {filme[3]} — {filme[4]} — {filme[5]}\n"
            locadora.frame_lista.insert("end", linha)

# Incluir registros
def incluir_filme():
    """Coleta os dados dos campos e salva no SQLite3."""
    titulo = locadora.txt_nome.get().strip()
    genero = locadora.txt_genero.get().strip()
    classind = locadora.txt_classind.get().strip()
    direcao = locadora.txt_direcao.get().strip()
    estudio = locadora.txt_estudio.get().strip()

    if not titulo or not genero or not classind or not direcao or not estudio:
        messagebox.showwarning("Aviso", "Por favor, preencha todos os campos!")
        return

    conn = conectar()
    cursor = conn.cursor()
    cursor.execute('INSERT INTO filmes (titulo, genero, classind, direcao, estudio) VALUES (?, ?, ?, ?, ?)', (titulo, genero, classind, direcao, estudio))
    conn.commit()
    conn.close()

    # # Limpa os campos de texto
    # locadora.txt_nome.delete(0, "end")
    # locadora.txt_genero.delete(0, "end")
    # locadora.txt_classind.delete(0, "end")
    # locadora.txt_direcao.delete(0, "end")
    # locadora.txt_estudio.delete(0, "end")

    # Atualiza a visualização
    atualizar_lista()
    messagebox.showinfo("Sucesso", f"'{titulo}' incluido!")

