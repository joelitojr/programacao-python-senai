print('1 - Faça um programa, utilizando ***while***, que mostre na tela os números de 0 a 1000.')
numcont=int(input('Informe o número inicial: '))
numfim=int(input('Informe o número final  : '))
while numcont <= numfim:
   print('Número: ',numcont)
   numcont = numcont + 1
else:
   print('Fim da contagem !!!')



