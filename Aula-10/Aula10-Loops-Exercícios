print('ATIVIDADE 1 - 2 - Faça um sistema, utilizando while e listas, que permita o usuário escrever o nome de 10 pessoas e os mostre na tela.')
lista_nomes=[]
contador=1
while contador <= 10:
    nome=input('Informe o nome: ')
    lista_nomes.append(nome)
    contador+=1 
else:
    print('Fim do cadastro !!!')
    print('Nomes incluídos: ',lista_nomes)


