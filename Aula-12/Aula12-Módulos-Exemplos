def calculo_sal_horas(carga , salario):
    return salario/ carga 

def hora_extra_hora(sal_hora):
    return sal_hora * 1.5

def total_hora_extra(valor_extra, q):
    return valor_extra * q

def sal_total (salario, total_extra):
    return salario + total_extra


