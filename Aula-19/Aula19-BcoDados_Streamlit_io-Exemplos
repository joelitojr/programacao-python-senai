dados  =  pd.read_csv('dados.csv')
df = pd.DataFrame(dados)
st.dataframe(df)
st.bar_chart(df, x = 'nome', y = 'nota')

n1 =  st.number_input('nº' )
n2 =  st.number_input('nº', value=0.0)

if st.button('Calcular...') :   
   if n1 and n2:
      soma  =  n1 + n2
      st.info( soma)
   else:
      print('Digite algo ')    



